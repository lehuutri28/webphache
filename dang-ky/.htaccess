# ============================================================
# /dang-ky/.htaccess — phache.com.vn
# Cắt kế thừa rule rewrite dòng 69 của CMS gốc.
# ============================================================

DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ep HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteRule ^ https://phache.com.vn%{REQUEST_URI} [R=301,L,NE]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://phache.com.vn%{REQUEST_URI} [R=301,L,NE]
</IfModule>
