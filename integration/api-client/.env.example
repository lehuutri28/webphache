# Phache → Wecha ERP integration — env config
# Deploy target: /config/.env (Mat Bao, chmod 600, KHÔNG commit git)
#
# Letri tự gõ trên server (rule feedback_no_password_in_chat).
#
# Brief: orchestrator-ceo/briefs/2026-05-02-BRIEF-PHACHE-SERVICE-ACCOUNT-JWT.md
# Service account email: service-phache@vuaantoan.com
# Tenant: 2eb99a91-6c1f-4c60-89c5-f19a6a3ee62f (VUA AN TOÀN)
# Role: phache_web_service
# Permissions: customers.view, customers.create, customer_crm.interactions.write, courses.available.read

WECHA_ERP_API_URL=https://erp.wecha.vn/api

# JWT initial seed (TTL 30 ngày, sau đó TokenRotator.php tự rotate qua /auth/service-token/rotate)
# Letri lấy token đầu tiên từ Opus CEO ERP cấp ngày 12/5/2026
# Token mới sau rotate được lưu tự động vào /cache/jwt-current.txt (CrmClient ưu tiên đọc cache)
WECHA_ERP_JWT=<paste-initial-jwt-30d-here>

# Branch UUID mặc định cho courses-list (B.4) — Phache HCM nếu có
WECHA_ERP_DEFAULT_BRANCH_ID=<phache-hcm-branch-uuid>

# Rate limit phía phache (defensive — ERP cũng enforce 60 req/phút)
PHACHE_INTERNAL_RATE_LIMIT_PER_MIN=60
